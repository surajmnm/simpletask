import { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Trash2, CheckCircle } from "lucide-react";

export default function TaskManager() {
  const [tasks, setTasks] = useState([]);
  const [completedTasks, setCompletedTasks] = useState([]);
  const [newTask, setNewTask] = useState("");
  const [dueDate, setDueDate] = useState("");
  const [assignedTo, setAssignedTo] = useState("");
  const [users, setUsers] = useState(["Alice", "Bob", "Charlie", "Diana"]);

  const addTask = () => {
    if (newTask.trim()) {
      setTasks(
        [...tasks, { text: newTask, due: dueDate, assignedTo, completed: false }].sort((a, b) =>
          (a.assignedTo || "").localeCompare(b.assignedTo || "")
        )
      );
      setNewTask("");
      setDueDate("");
      if (!users.includes(assignedTo) && assignedTo) {
        setUsers([...users, assignedTo]);
      }
      setAssignedTo("");
    }
  };

  const toggleTask = (index) => {
    const task = tasks[index];
    if (!task.completed) {
      setCompletedTasks([...completedTasks, { ...task, completed: true }]);
    }
    setTasks(tasks.filter((_, i) => i !== index));
  };

  const deleteTask = (index) => {
    setTasks(tasks.filter((_, i) => i !== index));
  };

  return (
    <div className="max-w-xl mx-auto mt-10 p-6 bg-white shadow-xl rounded-2xl">
      <h1 className="text-3xl font-bold mb-6 text-center text-gray-800">📝 Simple Task Manager</h1>
      <div className="flex flex-col gap-4 mb-6">
        <Input
          placeholder="Enter a new task"
          value={newTask}
          onChange={(e) => setNewTask(e.target.value)}
          className="rounded-xl"
        />
        <Input
          type="date"
          value={dueDate}
          onChange={(e) => setDueDate(e.target.value)}
          className="rounded-xl"
        />
        <select
          value={assignedTo}
          onChange={(e) => setAssignedTo(e.target.value)}
          className="border p-2 rounded-xl text-gray-700"
        >
          <option value="">Assign to</option>
          {users.map((user) => (
            <option key={user} value={user}>{user}</option>
          ))}
        </select>
        <Button onClick={addTask} className="rounded-xl bg-blue-600 hover:bg-blue-700">Add Task</Button>
      </div>

      <div className="space-y-3">
        {tasks.map((task, index) => (
          <Card key={index} className="bg-gray-50 border border-gray-200 rounded-xl">
            <CardContent className="flex items-center gap-4 p-4">
              <button onClick={() => toggleTask(index)}>
                <CheckCircle className="text-gray-400 hover:text-green-500 transition" />
              </button>
              <div className="flex-grow">
                <span className="block text-lg font-medium text-gray-800">{task.text}</span>
                {task.due && (
                  <span className="text-sm text-gray-500 block">Due: {task.due}</span>
                )}
                {task.assignedTo && (
                  <span className="text-sm text-blue-500 block">Assigned to: {task.assignedTo}</span>
                )}
              </div>
              <button onClick={() => deleteTask(index)}>
                <Trash2 className="text-red-500 hover:text-red-600 transition" />
              </button>
            </CardContent>
          </Card>
        ))}
      </div>

      {completedTasks.length > 0 && (
        <div className="mt-10">
          <h2 className="text-2xl font-semibold text-green-700 mb-4">✅ Completed Tasks</h2>
          <div className="space-y-3">
            {completedTasks.map((task, index) => (
              <Card key={index} className="bg-green-50 border border-green-200 rounded-xl">
                <CardContent className="p-4">
                  <span className="line-through text-gray-500 block text-lg">{task.text}</span>
                  {task.due && (
                    <span className="text-sm text-gray-400 block">Due: {task.due}</span>
                  )}
                  {task.assignedTo && (
                    <span className="text-sm text-green-600 block">Assigned to: {task.assignedTo}</span>
                  )}
                </CardContent>
              </Card>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
